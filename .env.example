# Copy to .env.local for development. Never copy values from the Polymers
# project (Technical plan §4.4). .env* files are git-ignored; this one is
# committed with a negation rule in .gitignore.

# Canonical origin, the www form (metadata, canonical URLs)
NEXT_PUBLIC_SITE_URL=

# "true" only for the production build: activates the claims gate.
# Inlined at build time; `npm run build:launch` sets it (and CLAIMS_AS_OF).
LAUNCH=

# Quote routing (Sitemap §7.3). Defaults: sales@ to, the named contact in cc.
# Comma-separated lists.
RFQ_TO=
RFQ_CC=
# General enquiries from the Contact page. Default: the general address.
GENERAL_TO=
# Client-owned archive mailbox so a provider failure never loses a lead (TD-05)
ARCHIVE_BCC=

# Email (TD-04, Resend). Without a key, preview/dev log sends instead and
# production refuses. MAIL_FROM needs the domain verified in Resend (Q-01);
# until then staging uses Resend's test sender.
RESEND_API_KEY=
MAIL_FROM=

# Cloudflare Turnstile (Technical §7.6). The widget is not built yet:
# leave both empty, or every submission will be rejected.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 (TD-06). Empty: no consent notice and nothing is sent.
# Set: a notice asks first; GA loads only after Accept. Set it only once the
# privacy policy is published (F-66), so the notice can link to it.
NEXT_PUBLIC_GA_ID=
