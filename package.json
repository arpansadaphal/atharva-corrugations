{
  "name": "atharva-corrugations",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:launch": "LAUNCH=true npm run check:claims && LAUNCH=true CLAIMS_AS_OF=$(date +%F) next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:contrast": "tsx scripts/contrast.ts",
    "check:banned": "tsx scripts/check-banned-strings.ts",
    "check:claims": "tsx scripts/check-claims.ts",
    "check:claims:launch": "LAUNCH=true tsx scripts/check-claims.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:contrast && npm run check:banned && npm run check:claims",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
